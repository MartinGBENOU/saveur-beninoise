# URL publique du site (utilisée pour le SEO, le sitemap et les partages)
NEXT_PUBLIC_SITE_URL=https://saveur-beninoise.vercel.app

# Connexion Neon Postgres — injectée automatiquement par l'intégration Vercel.
# En local : `vercel env pull .env.local`
DATABASE_URL=

# Mot de passe de la page /admin (commandes reçues)
ADMIN_PASSWORD=
